# GlideUp production settings. On the VM: cp .env.production.example .env, then fill in.
# deploy/setup-vm.sh generates every secret marked "generated" for you.
# Never commit the real .env.

# ----------------------------------------------------------------- site
# Your domain, or a free one from your VM IP: e.g. 140-238-12-34.sslip.io
DOMAIN=
ACME_EMAIL=
ENVIRONMENT=production
LOG_LEVEL=INFO

# ----------------------------------------------------------------- auth
AUTH_SECRET=generated
JWT_SECRET=generated
# Google OAuth client (console.cloud.google.com -> Credentials). Authorized redirect URI:
#   https://<DOMAIN>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Same value as AUTH_GOOGLE_ID (the API verifies Google ID tokens against it).
GOOGLE_CLIENT_ID=
# Comma-separated; these accounts become super admins on first sign-in.
ADMIN_EMAILS=

# ----------------------------------------------------------------- data (private to Docker)
POSTGRES_USER=glideup
POSTGRES_PASSWORD=generated
POSTGRES_DB=glideup
MEILI_MASTER_KEY=generated
S3_ACCESS_KEY=glideup
S3_SECRET_KEY=generated
S3_BUCKET_RESUMES=resumes

# ----------------------------------------------------------------- AI
# GitHub Models (free): fine-grained token with "Models: read". Primary for every chat task.
GITHUB_MODELS_TOKEN=
OPENROUTER_API_KEY=
# Hosted model first, local Ollama (in Docker on the VM) as fallback.
LLM_ROUTES={"resume_parse": ["github:openai/gpt-4.1-mini", "ollama:qwen2.5:3b"], "portfolio_parse": ["github:openai/gpt-4.1-mini", "ollama:qwen2.5:3b"], "skill_gap": ["github:openai/gpt-4.1-mini", "ollama:qwen2.5:3b"]}
LLM_TIMEOUT_SECONDS=60
LLM_PROVIDER_TIMEOUTS={"ollama": 240}

# ----------------------------------------------------------------- jobs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GITHUB_API_TOKEN=

# ----------------------------------------------------------------- email (reminders)
# Any SMTP provider, e.g. Gmail with an app password: smtp.gmail.com / 587 / STARTTLS.
# Leave SMTP_HOST empty to turn email off (in-app reminders still work).
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=GlideUp <no-reply@example.com>

# ----------------------------------------------------------------- code sandbox
CODE_RUNNER=piston

# ----------------------------------------------------------------- monitoring
METRICS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=generated
# Grafana is bound to 127.0.0.1 on the VM; open it with: ssh -L 3001:localhost:3001 <vm>
GRAFANA_URL=http://localhost:3001
