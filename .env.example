# =============================================================================
# GlideUp configuration. Copy to `.env` and adjust:   cp .env.example .env
# Every setting is read from the environment at runtime — no secrets or URLs in code.
# Values marked (phase N) are read starting from that build phase.
# =============================================================================

# ----------------------------------------------------------------- general
# local | test | staging | production. Non-local environments refuse unsafe settings.
ENVIRONMENT=local
LOG_LEVEL=INFO
# true = one JSON object per log line (for log tooling); false = readable console output.
LOG_JSON=true

# ----------------------------------------------------------------- host ports
# Change these if something else on your machine already uses the port.
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MEILI_PORT=7700
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ----------------------------------------------------------------- web (Next.js / Auth.js)
# Public URL of the web app. Must match WEB_PORT and your Google OAuth redirect URI.
AUTH_URL=http://localhost:3000
# Encrypts the session cookie. Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-random-32-plus-character-secret
# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Where the Next.js server reaches the API. Docker Compose overrides this to http://api:8000.
API_INTERNAL_URL=http://localhost:8000

# ----------------------------------------------------------------- API auth
# Signs GlideUp access/refresh tokens. Use 32+ random characters; must differ from AUTH_SECRET.
JWT_SECRET=replace-with-a-different-random-32-plus-character-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Seconds a just-rotated refresh token may be replayed by parallel requests (0 disables).
REFRESH_REUSE_GRACE_SECONDS=30
# Must equal AUTH_GOOGLE_ID: the API checks Google ID tokens were issued for this client.
GOOGLE_CLIENT_ID=
# Password-less "developer login" so you can use the app before configuring Google.
# Read by BOTH the API and the web app. Refused by the API outside local/test.
AUTH_DEV_LOGIN_ENABLED=true
# Comma-separated emails granted super_admin when they sign in (the only bootstrap path).
ADMIN_EMAILS=you@example.com
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------- PostgreSQL + pgvector
POSTGRES_USER=glideup
POSTGRES_PASSWORD=glideup
POSTGRES_DB=glideup
# For running the API outside Docker. Compose builds its own URL from the values above.
DATABASE_URL=postgresql+asyncpg://glideup:glideup@localhost:5432/glideup
DATABASE_POOL_SIZE=10

# ----------------------------------------------------------------- Redis / Celery
REDIS_URL=redis://localhost:6379/0
# Optional; default to REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ----------------------------------------------------------------- background jobs
# celery = Redis + worker containers (Docker). inline = run jobs inside the API process
# (local development without Docker/Redis). Same job code either way.
TASK_EXECUTION=celery

# ----------------------------------------------------------------- job search & ingestion
# meilisearch (falls back to the database automatically if it is down) | database
SEARCH_BACKEND=meilisearch
MEILI_URL=http://localhost:7700
MEILI_JOBS_INDEX=jobs
# Adzuna job API (free key at https://developer.adzuna.com). Adds broad India coverage.
# After setting these, enable the Adzuna source in Admin -> Jobs & Sources.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Without Celery Beat (TASK_EXECUTION=inline), the API checks for due ingestions every N minutes.
INLINE_SCHEDULER_MINUTES=5
MEILI_MASTER_KEY=local-dev-master-key-change-me

# ----------------------------------------------------------------- object storage (resumes)
# s3 = MinIO locally / any S3-compatible store in the cloud. local = a folder on disk
# (development without Docker). Compose always uses s3.
STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=./var/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=glideup
S3_SECRET_KEY=glideup-dev-secret
S3_BUCKET_RESUMES=resumes

# ----------------------------------------------------------------- email (phase 8)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=GlideUp <no-reply@glideup.local>

# ----------------------------------------------------------------- resumes
RESUME_MAX_BYTES=5242880
RESUME_MAX_PAGES=10

# ----------------------------------------------------------------- LLM providers
# Ollama runs on the host (not in Docker). Compose points containers at host.docker.internal.
# One-time setup:  ollama pull qwen2.5:3b   and   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
# Same server as seen from inside Docker containers.
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
OLLAMA_NUM_CTX=8192
# GitHub Models free tier: a fine-grained personal access token with "Models: read".
# When set, it becomes the fallback (and is much faster than a local model on CPU).
GITHUB_MODELS_TOKEN=
# OpenRouter free models.
OPENROUTER_API_KEY=
# Default timeout per call, plus per-provider overrides as JSON (local CPU models are slow).
LLM_TIMEOUT_SECONDS=90
LLM_PROVIDER_TIMEOUTS={"ollama": 240}
# Optional per-task routing as JSON: task -> ordered "provider:model" fallback chain.
# Defaults live in backend/app/llm/routing.py. Example:
# LLM_ROUTES={"resume_parse": ["github:openai/gpt-4.1-mini", "ollama:qwen2.5:3b"]}
LLM_ROUTES={}
# Use the heuristic mock provider as a last resort. Local/test only (refused in production).
LLM_ALLOW_MOCK_FALLBACK=true
# Mock provider behaviour (tests, load and chaos testing).
MOCK_LLM_DELAY_MS=0
MOCK_LLM_ERROR_RATE=0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# ----------------------------------------------------------------- observability
METRICS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=admin
